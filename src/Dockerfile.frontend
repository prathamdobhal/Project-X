# src/Dockerfile.frontend
FROM node:18-slim AS build

WORKDIR /app

# Copy package files from the REPOSITORY ROOT (context is root)
COPY package*.json ./

# Clean install
RUN rm -rf node_modules package-lock.json && \
    npm install

# Copy the entire frontend source (index.html, src/, public/, vite.config.ts, etc.)
# Since context is root, copy the frontend directory
COPY src/ ./src/
COPY index.html ./
COPY vite.config.ts ./
COPY tsconfig.json ./
COPY tsconfig.node.json ./

# Build the application
RUN npm run build

# Production stage
FROM nginx:stable-alpine

# Copy built files
COPY --from=build /app/dist /usr/share/nginx/html

# Copy nginx config
COPY src/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]